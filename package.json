{
  "name": "capstone-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "졸업작품 · 프로젝트와 AI 작업을 연결하는 데스크톱 프로토타입",
  "main": "dist/desktop/electron/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run build:electron && node --test tests/model.test.ts tests/desktop.test.ts tests/ai.test.ts",
    "test:ai-runtime": "npm run build:electron && node --test tests/ai-runtime.test.ts",
    "test:api": "npm run build:electron && node --test --test-timeout=15000 tests/local-api.test.ts",
    "test:ai-live": "node scripts/test-ai-live.mjs",
    "test:ui": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/websocket": "11.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "fastify": "5.12.5",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
